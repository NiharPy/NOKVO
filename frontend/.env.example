# Frontend runtime config — Vite reads any var prefixed with VITE_.
# Copy this file to ``.env`` (dev), ``.env.production`` (prod build), or
# ``.env.staging`` (staging build). Vite picks the right one for the mode
# passed to ``vite build --mode <mode>``.

# Backend HTTP origin (NO trailing slash, NO /api suffix).
# Dev default if unset:  http://localhost:8000
# Examples:
#   VITE_API_BASE_URL=https://api.nokvo.com
#   VITE_API_BASE_URL=https://staging-api.nokvo.com
VITE_API_BASE_URL=http://localhost:8000
