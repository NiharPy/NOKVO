# NOKVO production env — source for infra/gen_app_params.py.
#
# Copy to ../.env.prod and fill in. DO NOT COMMIT. Start from your working
# .env and apply the notes below. deploy.sh classifies each key as a Key Vault
# secret or a plain Container Apps env var (see SECRET_KEYS in gen_app_params.py).
#
# Keys marked [AUTO] are OVERRIDDEN by deploy.sh from Bicep outputs — leave
# placeholders. Everything else you must provide.

# ---- Core (required) ----
SECRET_KEY=<32+ random chars>
SUPERADMIN_JWT_SECRET_KEY=<random>
ORGANIZATION_JWT_SECRET_KEY=<random>
NOKVO_ONE_SETUP_JWT_SECRET_KEY=<random>
NOKVO_TOTP_ENCRYPTION_KEY=<fernet key>

# ---- Postgres ---- (USER/DB must match platform.bicep: nokvoadmin / nokvo;
#                     PASSWORD must equal the PG_ADMIN_PASSWORD you export)
POSTGRES_USER=nokvoadmin
POSTGRES_DB=nokvo
POSTGRES_PASSWORD=<= PG_ADMIN_PASSWORD>
POSTGRES_SERVER=AUTO   # [AUTO] set to the Flexible Server FQDN

# ---- Redis ---- [AUTO] deploy.sh builds rediss://...key... into Key Vault
REDIS_URL=AUTO

# ---- Azure identity / shared resources ----
AZURE_SUBSCRIPTION_ID=<sub id>
AZURE_TENANT_ID=<tenant id>
AZURE_DEFAULT_REGION=centralindia
AZURE_PREFER_MANAGED_IDENTITY=AUTO        # [AUTO] -> true
AZURE_MANAGED_IDENTITY_CLIENT_ID=AUTO     # [AUTO] -> identity client id
AZURE_SHARED_STORAGE_ACCOUNT=AUTO         # [AUTO]
AZURE_SHARED_KEY_VAULT_NAME=AUTO          # [AUTO]
AZURE_SHARED_STORAGE_CONTAINER=tenantdocs
# AZURE_CLIENT_SECRET is intentionally DROPPED in prod (managed identity instead)

# ---- Public URLs / WebAuthn ---- [AUTO] from API_DOMAIN/PORTAL_DOMAIN/RP_ID
AGENT_PUBLIC_BASE_URL=AUTO
PLIVO_WEBHOOK_BASE_URL=AUTO
NOKVO_ONE_PUBLIC_BASE_URL=AUTO
EXPECTED_ORIGIN=AUTO
RP_ID=AUTO
RP_NAME=NOKVO

# ---- Observability ---- [AUTO] OTEL on + App Insights connection string
ENVIRONMENT=AUTO                          # [AUTO] -> production
OTEL_ENABLED=AUTO
APPLICATIONINSIGHTS_CONNECTION_STRING=AUTO
LANGSMITH_API_KEY=                        # optional

# ---- Concurrency cap ----
NOKVO_MAX_CONCURRENT_CALLS_PER_TENANT=10

# ---- Telephony / STT / TTS (required for calls) ----
PLIVO_AUTH_ID=<...>
PLIVO_AUTH_TOKEN=<...>
PLIVO_NUMBER_COUNTRY=IN
PLIVO_AUTO_PROVISION=false
SARVAM_API_KEY=<...>

# ---- LLM pools ----
AZURE_OPENAI_POOL_JSON=<json>
AZURE_OPENAI_NANO_POOL_JSON=<json>
OPENAI_API_KEY=<embeddings fallback>

# ---- Payments (Razorpay LIVE) ----
RAZORPAY_KEY_ID=<...>
RAZORPAY_KEY_SECRET=<...>
RAZORPAY_WEBHOOK_SECRET=<...>

# ---- Lead sources (Meta) ----
META_ADS_APP_ID=<...>
META_ADS_APP_SECRET=<...>
META_LEADGEN_WEBHOOK_VERIFY_TOKEN=<...>
# [AUTO] OAuth redirect_uri — composed from API_DOMAIN by gen_app_params.py.
# Register the SAME URL in the Meta App's Valid OAuth Redirect URIs.
META_ADS_REDIRECT_URI=AUTO

# ---- CRM / Google OAuth ----
# [AUTO] Zoho redirect_uri composed from API_DOMAIN. Register it in Zoho too.
ZOHO_REDIRECT_URI=AUTO
# Leave GOOGLE_LEADS_OAUTH_REDIRECT_URI UNSET — it is derived per-provider
# (google_ads / google_forms) from the public base URL at runtime. Whitelist
# both .../oauth/google_ads/callback and .../oauth/google_forms/callback in the
# Google Cloud Console (under API_DOMAIN).

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<...>
SMTP_PASSWORD=<google app password>
SMTP_FROM_EMAIL=<...>

# ---- Retired ---- KB/RAG off in prod
QDRANT_URL=AUTO   # [AUTO] -> :memory:

# Include any other provider keys your tenants use (Google/Zoho OAuth, etc.).
